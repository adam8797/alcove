<Project>
  <!-- Settings shared by every project in the repository. Fixture plugins under tests/fixtures/
       deliberately do not inherit these (they have their own Directory.Build.props). -->

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITEA_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <AlcoveRepoRoot>$(MSBuildThisFileDirectory)</AlcoveRepoRoot>
  </PropertyGroup>

  <!-- One version for every package (implementation plan, Phase 1). Prerelease until the API settles. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>

  <!-- Package metadata -->
  <PropertyGroup>
    <Authors>Adam Schiavone</Authors>
    <Copyright>Copyright (c) Adam Schiavone</Copyright>
    <PackageOutputPath>$(AlcoveRepoRoot)artifacts/packages/$(Configuration)/</PackageOutputPath>
  </PropertyGroup>

  <!-- SourceLink: the SDK's built-in GitHub provider. Only with a git checkout, so builds from a source
       archive (no .git) stay warning-free. CI builds are marked deterministic for reproducible packages. -->
  <PropertyGroup>
    <RepositoryUrl>https://github.com/adam8797/alcove</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnableSourceLink Condition="!Exists('$(AlcoveRepoRoot).git')">false</EnableSourceLink>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
