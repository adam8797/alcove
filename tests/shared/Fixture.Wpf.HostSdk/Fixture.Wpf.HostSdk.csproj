<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WPF test host's app SDK: extension points and shared resource keys. Alcove.Wpf.TestHost references it (so
       it's in that host's deps.json and host-owned); the WPF fixture plugins (tests/fixtures/Wpf) build against the
       packed copy. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>Extension points of the Alcove WPF test host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Alcove.Abstractions\Alcove.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\Alcove.Wpf\Alcove.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/Fixture.Wpf.HostSdk.props" Pack="true" PackagePath="build/" />
  </ItemGroup>
</Project>
