<Project Sdk="Microsoft.NET.Sdk">
  <!-- A harness (style 1): starts a plugin host with the plugin under test loaded from its build output, plus the
       plugins installed in the plugin root given with -root. Prints CHECK-style lines for the tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Alcove" Version="$(AlcoveVersion)" />
    <PackageReference Include="Alcove.Sdk" Version="$(AlcoveVersion)" PrivateAssets="all" />
    <PackageReference Include="Fixture.HostContracts" Version="$(AlcoveVersion)" />
    <PluginUnderTest Include="../../Hosting/Fixture.Hosting.UserB/Fixture.Hosting.UserB.csproj" />
  </ItemGroup>
</Project>
