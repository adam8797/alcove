<Project Sdk="Microsoft.NET.Sdk">
  <!-- A XAML library that declares its plugin dictionaries with [assembly: PluginResources] (a same-named stand-in for
       Alcove.Wpf's attribute: it's read by name), and also has Themes/Plugin.xaml, which declaring replaces. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
