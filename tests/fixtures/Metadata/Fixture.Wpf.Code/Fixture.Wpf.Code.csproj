<Project Sdk="Microsoft.NET.Sdk">
  <!-- A WPF library without XAML (no .g.resources). The XAML libraries reference it from XAML only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
