<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Alcove.Abstractions\Alcove.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Alcove\Alcove.csproj" />
    <!-- PublicApi/ snapshots every shipping assembly. -->
    <ProjectReference Include="..\..\src\Alcove.DependencyInjection\Alcove.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Alcove.Autofac\Alcove.Autofac.csproj" />
    <!-- net10.0-windows, so build order only: read with a MetadataLoadContext (TestSupport/WpfAddOnMetadata.cs). -->
    <ProjectReference Include="..\..\src\Alcove.Wpf\Alcove.Wpf.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AlcoveRepoRoot" Value="$(AlcoveRepoRoot)" />
    <AssemblyMetadata Include="AlcoveWpfAssembly" Value="$(AlcoveRepoRoot)src/Alcove.Wpf/bin/$(Configuration)/net10.0-windows/Alcove.Wpf.dll" />
    <AssemblyMetadata Include="NetCoreTargetingPackRoot" Value="$(NetCoreTargetingPackRoot)" />
    <AssemblyMetadata Include="NuGetPackageRoot" Value="$(NuGetPackageRoot)" />
  </ItemGroup>

  <!-- Inspection/ tests inspect these fixture assemblies without loading them. Build order only; each fixture
       builds into tests/fixtures/Metadata/bin/<ProjectName>/ (see that folder's Directory.Build.props). -->
  <ItemGroup>
    <MetadataFixture Include="..\fixtures\Metadata\Fixture.Leak.Surface\Fixture.Leak.Surface.csproj" />
    <MetadataFixture Include="..\fixtures\Metadata\Fixture.Services.Plugin\Fixture.Services.Plugin.csproj" />
    <MetadataFixture Include="..\fixtures\Metadata\Fixture.Wpf.Code\Fixture.Wpf.Code.csproj" />
    <MetadataFixture Include="..\fixtures\Metadata\Fixture.Wpf.Controls.V1\Fixture.Wpf.Controls.V1.csproj" />
    <MetadataFixture Include="..\fixtures\Metadata\Fixture.Wpf.Controls.V2\Fixture.Wpf.Controls.V2.csproj" />
    <MetadataFixture Include="..\fixtures\Metadata\Fixture.Wpf.Controls.Unversioned\Fixture.Wpf.Controls.Unversioned.csproj" />
    <ProjectReference Include="@(MetadataFixture)" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>

</Project>
