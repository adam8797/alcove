<UserControl x:Class="PluginB.PluginBView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:PluginA;assembly=PluginA"
             xmlns:host="clr-namespace:HostSdk;assembly=HostSdk"
             xmlns:shared="clr-namespace:SharedControls;assembly=SharedControls">
    <UserControl.Resources>
        <!-- Q3: another plugin's dictionary by pack URI -->
        <ResourceDictionary Source="/PluginA;component/Themes/Plugin.xaml" />
    </UserControl.Resources>
    <StackPanel Margin="4">
        <TextBlock Text="MARK:PluginB.PluginBView" FontWeight="Bold" />
        <!-- Q3: type from ANOTHER plugin's assembly (PluginA, in a different compartment) -->
        <a:AStatusText x:Name="OtherPluginText" />
        <TextBlock x:Name="OtherPluginGreeting" Text="{StaticResource PluginA.Greeting}" />
        <host:SharedBanner x:Name="Banner" />
        <shared:VersionBadge x:Name="Badge" />
        <shared:FancyBox x:Name="Fancy" />
    </StackPanel>
</UserControl>
