<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-platform (runs on Linux). Inspects assemblies WITHOUT loading them for execution:
       identity, whether they carry WPF resources (<Name>.g.resources), the BAML parts, and the assembly
       names recorded inside each BAML stream. Doubles as a prototype for the duplicate-XAML-assembly
       warning (detection needs only System.Reflection.Metadata). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <EnableWindowsTargeting>false</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
