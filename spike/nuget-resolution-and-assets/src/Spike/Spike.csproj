<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>$(NoWarn);NU1903;NU1902</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- NuGet client libraries under evaluation -->
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="NuGet.Resolver" Version="7.9.0" />
    <PackageReference Include="NuGet.DependencyResolver.Core" Version="7.9.0" />
    <!-- "Host" packages so the inventory has something interesting:
         old Serilog (Serilog.Sinks.File needs newer), old M.E.Logging.Abstractions,
         System.Text.Json 9 (framework provides 10 -> expect pruning). -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="PortableRuntimeIdentifierGraph.json" LogicalName="rid-graph.json" />
  </ItemGroup>
</Project>
