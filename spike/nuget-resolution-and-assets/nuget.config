<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="spike-fixtures" value="work/feed" />
  </packageSources>
  <config>
    <!-- keep fixture packages out of ~/.nuget/packages so re-packing a version is picked up -->
    <add key="globalPackagesFolder" value="work/gpf" />
  </config>
</configuration>
