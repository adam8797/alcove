<Window x:Class="WpfHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sdk="clr-namespace:WpfHost.Sdk;assembly=WpfHost.Sdk"
        Title="Alcove WPF sample" Width="1000" Height="680"
        Background="{DynamicResource {x:Static sdk:SampleKeys.PanelBackground}}">
    <DockPanel Margin="8">
        <ListBox x:Name="Log" DockPanel.Dock="Bottom" Height="140" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11" />
        <StackPanel DockPanel.Dock="Left" Width="280" Margin="0,0,8,0">
            <sdk:PanelHeader Title="Plugins" />
            <ItemsControl x:Name="Plugins" Margin="0,0,0,12" />
            <sdk:PanelHeader Title="On the feed" />
            <ListBox x:Name="Available" Height="120" DisplayMemberPath="Id" />
            <Button x:Name="Install" Content="Install (hot)" Margin="0,6,0,0" Click="OnInstall" />
            <Button x:Name="PopOut" Content="Open the selected panel in a window" Margin="0,6,0,0" Click="OnPopOut" />
            <Button Content="Switch accent colour" Margin="0,6,0,0" Click="OnSwitchAccent" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <TabControl x:Name="Panels" />
    </DockPanel>
</Window>
