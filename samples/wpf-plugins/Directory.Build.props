<Project>
  <!-- The WPF sample's plugins are built like third-party plugins: they don't import the repository's settings and
       reference the packed Alcove.Sdk and WpfHost.Sdk from a local feed (run-wpf-sample.ps1 / .sh set it up).
       Required global property: AlcoveVersion. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU5104: stable sample packages depend on the prerelease (0.x-dev) Alcove packages. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <IsPackable>true</IsPackable>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Authors>Alcove samples</Authors>
    <Description>Alcove WPF sample plugin.</Description>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
</Project>
