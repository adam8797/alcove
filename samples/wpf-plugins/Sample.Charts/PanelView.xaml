<UserControl x:Class="Sample.Charts.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:WpfHost.Sdk;assembly=WpfHost.Sdk"
             xmlns:controls="clr-namespace:Sample.Wpf.Controls;assembly=Sample.Wpf.Controls">
    <StackPanel Margin="12">
        <sdk:PanelHeader Title="Charts" />
        <!-- Sample.Wpf.Controls is used only from XAML: Alcove.Wpf pre-loads it, or WPF would look for it in the default context. -->
        <controls:Gauge Label="CPU" Value="72" />
        <controls:Gauge Label="Memory" Value="41" BarBrush="{DynamicResource {x:Static sdk:SampleKeys.AccentBrush}}" />
        <controls:Gauge Label="Disk" Value="88" />
    </StackPanel>
</UserControl>
