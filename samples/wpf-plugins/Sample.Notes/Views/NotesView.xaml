<UserControl x:Class="Sample.Notes.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:WpfHost.Sdk;assembly=WpfHost.Sdk">
    <DockPanel Margin="12">
        <sdk:PanelHeader DockPanel.Dock="Top" Title="{Binding Title}" />
        <!-- Sample.Notes.Paper comes from this plugin's Themes/Plugin.xaml. -->
        <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" Padding="8"
                 Background="{StaticResource Sample.Notes.Paper}"
                 BorderBrush="{DynamicResource {x:Static sdk:SampleKeys.AccentBrush}}" />
    </DockPanel>
</UserControl>
