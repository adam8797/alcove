<UserControl x:Class="Sample.Wpf.Controls.Gauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="44">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, ElementName=Root}" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Height="14" Minimum="0" Maximum="100" Value="{Binding Value, ElementName=Root}"
                     Foreground="{Binding BarBrush, ElementName=Root}" />
        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Root, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
</UserControl>
