<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sample host's contracts package: its extension points. The host ships it (host-owned); plugins
       reference the packed copy. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Extension points of the Alcove console sample host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Alcove.Abstractions\Alcove.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/ConsoleHost.Contracts.props" Pack="true" PackagePath="build/" />
  </ItemGroup>
</Project>
