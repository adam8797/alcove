<Project Sdk="Microsoft.NET.Sdk">
  <!-- The ordinary library Sample.Text 2.0.0 that plugins depend on. -->
  <PropertyGroup>
    <PackageId>Sample.Text</PackageId>
    <AssemblyName>Sample.Text</AssemblyName>
    <RootNamespace>Sample.Text</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <DefineConstants>$(DefineConstants);V2</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Sample.Text/Text.cs" />
  </ItemGroup>
</Project>
