<Project>
  <!-- A plugin that references Alcove.DependencyInjection (for IServicePlugin) runs in a host that provides it:
       Alcove.Sdk keeps it, and the container behind it, a dependency but never copies them to the output (the
       core's own buildTransitive targets do the same for the core). Inert in projects that don't use Alcove.Sdk
       (such as the host app). -->
  <ItemGroup>
    <PluginHostOwnedPackage Include="Alcove.DependencyInjection" />
    <PluginHostOwnedPackage Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
