<Project>
  <!-- Alcove.Sdk: imported after the plugin's project file. See Alcove.Sdk.props for the inputs. -->

  <PropertyGroup>
    <!-- An exe referencing Alcove.Sdk is a harness, not a plugin: none of the plugin targets apply to it. -->
    <AlcoveIsPlugin Condition="'$(AlcoveIsPlugin)' == '' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">false</AlcoveIsPlugin>
    <AlcoveIsPlugin Condition="'$(AlcoveIsPlugin)' == ''">true</AlcoveIsPlugin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AlcoveIsPlugin)' == 'true'">
    <!-- The build output is loadable as a development plugin: dependencies (RID-specific and native assets
         included) are copied next to the plugin; host-owned packages stay excluded (below). -->
    <EnableDynamicLoading Condition="'$(EnableDynamicLoading)' == ''">true</EnableDynamicLoading>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AlcoveIsPlugin)' == 'true'">
    <!-- Must match Alcove.Packaging.PluginManifest.CurrentSchemaVersion. -->
    <AlcovePluginManifestSchemaVersion>1</AlcovePluginManifestSchemaVersion>

    <PackageType Condition="'$(PluginPackageType)' != ''">$(PluginPackageType)</PackageType>

    <!--
      Explicit AssemblyVersion at evaluation time (major.minor.patch.0 from Version), unless the project set
      one. The SDK's default is computed later, during execution, which leaves WPF's InitializeComponent URIs
      unversioned (spike: wpf-across-load-contexts).
    -->
    <_AlcoveVersionNumbers>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+(\.\d+)*').Value)</_AlcoveVersionNumbers>
    <_AlcoveAssemblyVersion Condition="'$(_AlcoveVersionNumbers)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_AlcoveVersionNumbers).0.0', '^\d+\.\d+\.\d+').Value).0</_AlcoveAssemblyVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(_AlcoveAssemblyVersion)</AssemblyVersion>
  </PropertyGroup>

  <Target Name="AlcoveValidatePluginProperties" BeforeTargets="BeforeBuild;GenerateNuspec" Condition="'$(AlcoveIsPlugin)' == 'true'">
    <ItemGroup>
      <_AlcovePrivateNotHostOwned Include="@(PluginPrivateDependency)" Exclude="@(PluginHostOwnedPackage)" />
      <_AlcovePrivateHostOwned Include="@(PluginPrivateDependency)" Exclude="@(_AlcovePrivateNotHostOwned)" />
      <_AlcoveInvalidPrivateDependency Include="@(PluginPrivateDependency)"
          Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^[A-Za-z0-9_][A-Za-z0-9_.\-]*$'))" />
    </ItemGroup>

    <Error Code="ALCOVE001" Condition="'$(PluginPackageType)' == ''"
           Text="Alcove.Sdk: set the PluginPackageType property to the host's plugin package type (for example &lt;PluginPackageType&gt;MyAppPlugin&lt;/PluginPackageType&gt;). The host's contracts package may set it for you; check that you reference it." />
    <Error Code="ALCOVE002" Condition="'$(PluginIsolated)' != '' and '$(PluginIsolated)' != 'true' and '$(PluginIsolated)' != 'false'"
           Text="Alcove.Sdk: PluginIsolated must be 'true' or 'false', not '$(PluginIsolated)'." />
    <Error Code="ALCOVE003" Condition="'$(PluginCell)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(PluginCell)', '^[^&quot;\\\x00-\x1F]+$'))"
           Text="Alcove.Sdk: PluginCell '$(PluginCell)' must not contain quotes, backslashes or control characters." />
    <Error Code="ALCOVE004" Condition="'$(PluginEntryPoint)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(PluginEntryPoint)', '^[^&quot;\\\x00-\x1F\s]+$'))"
           Text="Alcove.Sdk: PluginEntryPoint '$(PluginEntryPoint)' must be the full name of the IPlugin type, for example Contoso.Charts.ChartsPlugin." />
    <Error Code="ALCOVE005" Condition="'@(_AlcoveInvalidPrivateDependency)' != ''"
           Text="Alcove.Sdk: PluginPrivateDependency '@(_AlcoveInvalidPrivateDependency)' is not a valid package ID." />
    <Error Code="ALCOVE006" Condition="'@(_AlcovePrivateHostOwned)' != ''"
           Text="Alcove.Sdk: '@(_AlcovePrivateHostOwned)' is host-owned and is always loaded from the host, so it can't be a PluginPrivateDependency." />
  </Target>

  <!-- Generates <PackageId>.plugin.json, packs it at the package root and copies it into the build output (so the
       build output loads as a development plugin; packageId and version identify it there). -->
  <Target Name="AlcoveGeneratePluginManifest"
          BeforeTargets="_GetPackageFiles;CopyFilesToOutputDirectory"
          DependsOnTargets="AlcoveValidatePluginProperties"
          Condition="'$(AlcoveIsPlugin)' == 'true'">
    <ItemGroup>
      <_AlcovePrivateDependencyDistinct Include="@(PluginPrivateDependency->Distinct())" />
    </ItemGroup>

    <PropertyGroup>
      <!-- PackageId gets its default after this file is imported, so the name is computed here. -->
      <PluginManifestFileName Condition="'$(PluginManifestFileName)' == ''">$(PackageId).plugin.json</PluginManifestFileName>
      <_AlcoveNL>&#10;</_AlcoveNL>
      <_AlcoveIsolated>false</_AlcoveIsolated>
      <_AlcoveIsolated Condition="'$(PluginIsolated)' == 'true'">true</_AlcoveIsolated>
      <_AlcovePrivateDependencies>@(_AlcovePrivateDependencyDistinct->'&quot;%(Identity)&quot;', ', ')</_AlcovePrivateDependencies>
      <_AlcovePrivateDependencies Condition="'$(_AlcovePrivateDependencies)' != ''"> $(_AlcovePrivateDependencies) </_AlcovePrivateDependencies>
      <_AlcoveManifestJson>{$(_AlcoveNL)  &quot;schemaVersion&quot;: $(AlcovePluginManifestSchemaVersion),$(_AlcoveNL)  &quot;packageId&quot;: &quot;$(PackageId)&quot;,$(_AlcoveNL)  &quot;version&quot;: &quot;$(PackageVersion)&quot;,</_AlcoveManifestJson>
      <_AlcoveManifestJson Condition="'$(PluginEntryPoint)' != ''">$(_AlcoveManifestJson)$(_AlcoveNL)  &quot;entryPoint&quot;: &quot;$(PluginEntryPoint)&quot;,</_AlcoveManifestJson>
      <_AlcoveManifestJson Condition="'$(PluginCell)' != ''">$(_AlcoveManifestJson)$(_AlcoveNL)  &quot;cell&quot;: &quot;$(PluginCell)&quot;,</_AlcoveManifestJson>
      <_AlcoveManifestJson>$(_AlcoveManifestJson)$(_AlcoveNL)  &quot;isolated&quot;: $(_AlcoveIsolated),$(_AlcoveNL)  &quot;privateDependencies&quot;: [$(_AlcovePrivateDependencies)]$(_AlcoveNL)}</_AlcoveManifestJson>
      <PluginManifestPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(PluginManifestFileName)'))</PluginManifestPath>
    </PropertyGroup>

    <WriteLinesToFile File="$(PluginManifestPath)"
                      Lines="$([MSBuild]::Escape('$(_AlcoveManifestJson)'))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(PluginManifestPath)" />
      <_PackageFiles Include="$(PluginManifestPath)" PackagePath="$(PluginManifestFileName)" BuildAction="None" />
    </ItemGroup>
  </Target>

  <Target Name="AlcoveCopyPluginManifestToOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="AlcoveGeneratePluginManifest"
          Condition="'$(AlcoveIsPlugin)' == 'true'">
    <!-- A Copy, not a CopyToOutputDirectory item, so the manifest never flows into referencing projects' output. -->
    <Copy SourceFiles="$(PluginManifestPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)$(PluginManifestFileName)" />
    </ItemGroup>
  </Target>

  <!--
    Host-owned packages stay nuspec dependencies, but their runtime assets are never copied into the build
    output (relevant with CopyLocalLockFileAssemblies / EnableDynamicLoading, and for local debugging).
    This works on build-time items, so it's unaffected by whether restore has seen this package's props.
  -->
  <Target Name="AlcoveExcludeHostOwnedRuntimeAssets" AfterTargets="ResolvePackageAssets" Condition="'$(AlcoveIsPlugin)' == 'true'">
    <ItemGroup>
      <_AlcoveHostOwnedPackageId Include="@(PluginHostOwnedPackage)" NuGetPackageId="%(Identity)" />
      <RuntimeCopyLocalItems Remove="@(_AlcoveHostOwnedPackageId)" MatchOnMetadata="NuGetPackageId" MatchOnMetadataOptions="CaseInsensitive" />
      <NativeCopyLocalItems Remove="@(_AlcoveHostOwnedPackageId)" MatchOnMetadata="NuGetPackageId" MatchOnMetadataOptions="CaseInsensitive" />
      <ResourceCopyLocalItems Remove="@(_AlcoveHostOwnedPackageId)" MatchOnMetadata="NuGetPackageId" MatchOnMetadataOptions="CaseInsensitive" />
    </ItemGroup>
  </Target>

  <!--
    Harness style 1 (a harness project): PluginUnderTest items. The plugin is built first but never referenced,
    copied into the harness output or loaded into the default context; its build output folder is recorded in a
    generated [assembly: Alcove.Development.AlcoveDevelopmentPlugin(...)], which AddDevelopmentPluginsFrom reads.
  -->
  <ItemGroup Condition="'@(PluginUnderTest)' != ''">
    <ProjectReference Include="@(PluginUnderTest)">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>all</ExcludeAssets>
      <AlcovePluginUnderTest>true</AlcovePluginUnderTest>
    </ProjectReference>
  </ItemGroup>

  <!-- The first restore of a harness runs before this file is imported, so it doesn't see PluginUnderTest: a plugin
       under test that was never restored (default obj/ layout) is restored here, before anything evaluates it. -->
  <Target Name="AlcoveRestorePluginsUnderTest"
          BeforeTargets="AssignProjectConfiguration"
          Condition="'@(PluginUnderTest)' != ''">
    <ItemGroup>
      <_AlcovePluginUnderTestToRestore Include="@(PluginUnderTest)" Condition="!Exists('%(RootDir)%(Directory)obj/project.assets.json')" />
    </ItemGroup>

    <MSBuild Projects="@(_AlcovePluginUnderTestToRestore)"
             Targets="Restore"
             Properties="_AlcoveRestoreSession=$([System.Guid]::NewGuid())"
             Condition="'@(_AlcovePluginUnderTestToRestore)' != ''" />
  </Target>

  <Target Name="AlcoveGenerateDevelopmentPluginAttributes"
          BeforeTargets="GetAssemblyAttributes"
          DependsOnTargets="PrepareProjectReferences"
          Condition="'@(PluginUnderTest)' != ''">
    <ItemGroup>
      <_AlcovePluginUnderTestReference Include="@(_MSBuildProjectReferenceExistent)" Condition="'%(_MSBuildProjectReferenceExistent.AlcovePluginUnderTest)' == 'true'" />
    </ItemGroup>

    <MSBuild Projects="@(_AlcovePluginUnderTestReference)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_AlcovePluginUnderTestReference.SetConfiguration); %(_AlcovePluginUnderTestReference.SetPlatform); %(_AlcovePluginUnderTestReference.SetTargetFramework)"
             RemoveProperties="%(_AlcovePluginUnderTestReference.GlobalPropertiesToRemove)">
      <Output TaskParameter="TargetOutputs" ItemName="_AlcovePluginUnderTestPath" />
    </MSBuild>

    <ItemGroup>
      <AssemblyAttribute Include="Alcove.Development.AlcoveDevelopmentPluginAttribute">
        <_Parameter1>%(_AlcovePluginUnderTestPath.RootDir)%(_AlcovePluginUnderTestPath.Directory)</_Parameter1>
        <ProjectPath>%(_AlcovePluginUnderTestPath.MSBuildSourceProjectFile)</ProjectPath>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!--
    Harness style 2 (F5 on the plugin project): AlcoveHarnessExecutable makes `dotnet run` (RunCommand,
    RunArguments) and IDEs (a generated launch profile) start the harness with this plugin's build output.
  -->
  <PropertyGroup Condition="'$(AlcoveHarnessExecutable)' != ''">
    <_AlcoveHarnessIsDll Condition="$(AlcoveHarnessExecutable.ToLowerInvariant().EndsWith('.dll'))">true</_AlcoveHarnessIsDll>
    <_AlcoveDotNet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_AlcoveDotNet>
    <_AlcoveDotNet Condition="'$(_AlcoveDotNet)' == ''">dotnet</_AlcoveDotNet>
    <RunCommand Condition="'$(_AlcoveHarnessIsDll)' == 'true'">$(_AlcoveDotNet)</RunCommand>
    <RunCommand Condition="'$(_AlcoveHarnessIsDll)' != 'true'">$(AlcoveHarnessExecutable)</RunCommand>
    <AlcoveGenerateLaunchSettings Condition="'$(AlcoveGenerateLaunchSettings)' == ''">true</AlcoveGenerateLaunchSettings>
  </PropertyGroup>

  <Target Name="AlcoveComputeHarnessArguments" Condition="'$(AlcoveHarnessExecutable)' != ''">
    <PropertyGroup>
      <!-- No trailing separator: "C:\out\" would escape its closing quote on Windows. -->
      <_AlcoveDevelopmentPluginDirectory>$(TargetDir.TrimEnd('/').TrimEnd('\'))</_AlcoveDevelopmentPluginDirectory>
      <_AlcoveHarnessArguments>--alcove-dev-plugin &quot;$(_AlcoveDevelopmentPluginDirectory)&quot;</_AlcoveHarnessArguments>
      <_AlcoveHarnessArguments Condition="'$(AlcoveHarnessArguments)' != ''">$(_AlcoveHarnessArguments) $(AlcoveHarnessArguments)</_AlcoveHarnessArguments>
      <_AlcoveHarnessDirectory>$([System.IO.Path]::GetDirectoryName('$(AlcoveHarnessExecutable)'))</_AlcoveHarnessDirectory>
      <_AlcoveHarnessCommandLine>$(_AlcoveHarnessArguments)</_AlcoveHarnessCommandLine>
      <_AlcoveHarnessCommandLine Condition="'$(_AlcoveHarnessIsDll)' == 'true'">&quot;$(AlcoveHarnessExecutable)&quot; $(_AlcoveHarnessArguments)</_AlcoveHarnessCommandLine>
    </PropertyGroup>
  </Target>

  <Target Name="AlcoveSetHarnessRunArguments"
          BeforeTargets="ComputeRunArguments"
          DependsOnTargets="AlcoveComputeHarnessArguments"
          Condition="'$(AlcoveHarnessExecutable)' != ''">
    <PropertyGroup>
      <RunArguments>$(_AlcoveHarnessCommandLine)</RunArguments>
      <RunWorkingDirectory Condition="'$(_AlcoveHarnessDirectory)' != ''">$(_AlcoveHarnessDirectory)</RunWorkingDirectory>
    </PropertyGroup>
  </Target>

  <!-- Writes a launchSettings.json with one "Executable" profile. A task, not WriteLinesToFile: MSBuild turns the
       backslashes of JSON escapes into slashes in item specs on Unix. -->
  <UsingTask TaskName="AlcoveWriteLaunchSettings" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <ProfileName ParameterType="System.String" Required="true" />
      <ExecutablePath ParameterType="System.String" Required="true" />
      <CommandLineArgs ParameterType="System.String" Required="true" />
      <WorkingDirectory ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        System.Func<string, string> json = value =>
        {
            var text = new System.Text.StringBuilder("\"");
            foreach (var c in value)
            {
                switch (c)
                {
                    case '"': text.Append("\\\""); break;
                    case '\\': text.Append("\\\\"); break;
                    default:
                        if (c < ' ') { text.Append("\\u").Append(((int)c).ToString("x4")); } else { text.Append(c); }
                        break;
                }
            }

            return text.Append('"').ToString();
        };

        var nl = System.Environment.NewLine;
        var content = "{" + nl
            + "  \"profiles\": {" + nl
            + "    " + json(ProfileName) + ": {" + nl
            + "      \"commandName\": \"Executable\"," + nl
            + "      \"executablePath\": " + json(ExecutablePath) + "," + nl
            + "      \"commandLineArgs\": " + json(CommandLineArgs)
            + (string.IsNullOrEmpty(WorkingDirectory) ? "" : "," + nl + "      \"workingDirectory\": " + json(WorkingDirectory))
            + nl + "    }" + nl + "  }" + nl + "}" + nl;
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(File));
        System.IO.File.WriteAllText(File, content);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Visual Studio starts a class library only through a launch profile: an "Executable" one, if there's none. -->
  <Target Name="AlcoveGenerateLaunchSettings"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="AlcoveComputeHarnessArguments"
          Condition="'$(AlcoveHarnessExecutable)' != '' and '$(AlcoveGenerateLaunchSettings)' == 'true' and !Exists('$(MSBuildProjectDirectory)/Properties/launchSettings.json')">
    <PropertyGroup>
      <_AlcoveLaunchExecutable>$(AlcoveHarnessExecutable)</_AlcoveLaunchExecutable>
      <_AlcoveLaunchExecutable Condition="'$(_AlcoveHarnessIsDll)' == 'true'">dotnet</_AlcoveLaunchExecutable>
    </PropertyGroup>

    <AlcoveWriteLaunchSettings File="$(MSBuildProjectDirectory)/Properties/launchSettings.json"
                               ProfileName="$(MSBuildProjectName) in harness"
                               ExecutablePath="$(_AlcoveLaunchExecutable)"
                               CommandLineArgs="$(_AlcoveHarnessCommandLine)"
                               WorkingDirectory="$(_AlcoveHarnessDirectory)" />
    <Message Importance="high" Text="Alcove.Sdk: generated Properties/launchSettings.json to start $(AlcoveHarnessExecutable) with this plugin (delete it to regenerate)." />
  </Target>
</Project>
